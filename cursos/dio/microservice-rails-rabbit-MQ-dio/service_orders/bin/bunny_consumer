#!/usr/bin/env ruby

require File.expand_path('../config/environment', __dir__)
connection = Bunny.new(ENV.fetch('CLOUDAMQP_URL'))
connection.start
channel = connection.create_channel

queue = channel.queue('service_ordens.in', durable: true, auto_delete: false)

puts ("\nStarting consumer!")

fanout_name = 'users.out'
queue.bind(channel.exchange(fanout_name, type: 'fanout'))
puts "[consumer] #{queue.name} binds to #{fanout_name}"

queue.subscribe do |d_info, properties, payload|
  BunnyConsumerServices.call!(properties, payload)
  puts "[consumer] #{queue.name} received #{properties[:type]}, from #{properties[:app_id]}: #{payload}"
end

begin
  while true
    sleep(3)
  end
rescue Interrupt
  connection.close
  puts "\nSutting dow gracefully."
  exit
end
